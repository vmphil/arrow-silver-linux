## Arrow Silver PineTab2 — generated by build-pinetab2-image.sh
## Paths are relative to the /boot partition.
##
## Hardware revisions:
##   v2.0 (most units):  rk3566-pinetab2-v2.0.dtb   (default)
##   v0.1 (early HW):    rk3566-pinetab2-v0.1.dtb   — change FDT lines below
##
## 2026-10-17 boot debugging: verbose by default (no quiet/splash), earlycon on
## the debug UART (ttyS2 = uart2 @ 0xfe660000, 1500000 8N1), and a menu on the
## UART so a fallback entry can be picked. Last console= (tty1) is /dev/console.
MENU TITLE Arrow Silver (PineTab2)
DEFAULT arrowsilver
PROMPT 1
TIMEOUT 50

LABEL arrowsilver
	MENU LABEL Arrow Silver Linux (PineTab2, verbose)
	LINUX /vmlinuz-@KVER@
	INITRD /initrd.img-@KVER@
	FDT /dtbs/rockchip/@DTB@
	APPEND root=UUID=@ROOT_UUID@ rootfstype=ext4 rootwait rw earlycon=uart8250,mmio32,0xfe660000 console=ttyS2,1500000n8 console=tty1 loglevel=7 ignore_loglevel plymouth.enable=0

LABEL stockdtb
	MENU LABEL Arrow Silver, Debian stock DTB (no BES2600 Wi-Fi nodes)
	LINUX /vmlinuz-@KVER@
	INITRD /initrd.img-@KVER@
	FDT /dtbs/rockchip/stock/@DTB@
	APPEND root=UUID=@ROOT_UUID@ rootfstype=ext4 rootwait rw earlycon=uart8250,mmio32,0xfe660000 console=ttyS2,1500000n8 console=tty1 loglevel=7 ignore_loglevel plymouth.enable=0

LABEL rescue
	MENU LABEL Arrow Silver, initramfs shell (break=mount, no root mount)
	LINUX /vmlinuz-@KVER@
	INITRD /initrd.img-@KVER@
	FDT /dtbs/rockchip/@DTB@
	APPEND root=UUID=@ROOT_UUID@ rootfstype=ext4 rootwait earlycon=uart8250,mmio32,0xfe660000 console=tty1 console=ttyS2,1500000n8 loglevel=7 ignore_loglevel plymouth.enable=0 break=mount
